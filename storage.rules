rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Snapshots live under {projectId}/snapshots/**.
    // The device's custom token (mintDeviceToken.ts) mints uid as
    // "device:{projectId}", NOT projectId itself — projectId and role live
    // only in custom claims (auth.token.projectId / auth.token.role). Do not
    // gate on request.auth.uid == projectId; it can never match. Mirror
    // database.rules.json's claim-based check instead.
    // Reads: any signed-in member of the project, scoped by the projectId
    // claim. Snapshots are premises images — more sensitive than RTDB
    // metadata — so this is tighter than the any-signed-in-user posture used
    // for RTDB reads.
    // Writes: the device identity only (role == 'device' and its own
    // projectId claim), and only JPEGs under its own project.
    match /{projectId}/snapshots/{allPaths=**} {
      allow read: if request.auth != null
                  && request.auth.token.projectId == projectId;
      allow write: if request.auth != null
                   && request.auth.token.role == 'device'
                   && request.auth.token.projectId == projectId
                   && request.resource.contentType == 'image/jpeg'
                   && request.resource.size < 2 * 1024 * 1024;
    }

    // Firmware images for over-the-air updates, published by
    // functions/scripts/publishFirmware.ts through the admin SDK (which
    // bypasses these rules). The device downloads with its own ID token.
    //
    // NO client may write here, ever: /commands/ota is writable by any
    // signed-in user, and this prefix is the only thing that limits what such
    // a command can make a device flash to a release that was published.
    // Not project-scoped — one build serves every device.
    match /firmware/{allPaths=**} {
      allow read: if request.auth != null
                  && request.auth.token.role == 'device';
      allow write: if false;
    }
  }
}
